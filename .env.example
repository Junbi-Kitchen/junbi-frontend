# Firebase project config — copy from Firebase Console > Project Settings > Your apps > Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Backend API URL
# Leave blank in development — the app auto-detects the backend IP from Expo's dev server.
# Set this for production (e.g. https://your-api.com) or to explicitly override in dev.
EXPO_PUBLIC_API_URL=
